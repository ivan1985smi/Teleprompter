import Foundation
import QuartzCore
import CoreGraphics
import Combine
import Speech
import AVFoundation

struct VoiceWordAnchor {
    let index: Int
    let normalizedWord: String
    let stem: String
    let charRange: NSRange
    let targetScrollY: CGFloat
}

protocol PrompterScrollSurface: AnyObject {
    func displayScrollPosition(_ position: CGFloat)
    func setManualScrollingEnabled(_ enabled: Bool)
}

final class ScrollEngine: ObservableObject {
    @Published private(set) var isPlaying: Bool = false
    @Published private(set) var progress: Double = 0
    @Published private(set) var remainingSeconds: Int = 0
    @Published private(set) var reachedEnd: Bool = false

    // Состояние голосового управления
    @Published private(set) var isVoiceFollowActive: Bool = false
    @Published private(set) var voiceStatusText: String = "Голос: Выкл"
    @Published private(set) var voiceAudioLevel: Float = 0

    var speed: Double = 75 {
        didSet {
            updateRemainingTime()
        }
    }
    weak var surface: PrompterScrollSurface?

    private var displayLink: CADisplayLink?
    private var lastTimestamp: CFTimeInterval?

    private var position: CGFloat = 0
    private var maxPosition: CGFloat = 1
    private var viewportHeight: CGFloat = 600

    private var pendingSeekOffset: CGFloat = 0
    private var lastPublishedProgress: Double = -1

    // MARK: - Голосовой движок (Speech + AudioEngine)
    private var voiceAnchors: [VoiceWordAnchor] = []
    private var currentAnchorIndex: Int = 0
    private var voiceTargetY: CGFloat = 0

    private let audioEngine = AVAudioEngine()
    private var speechRecognizer: SFSpeechRecognizer? = SFSpeechRecognizer(locale: Locale(identifier: "ru-RU"))
    private var recognitionRequest: SFSpeechAudioBufferRecognitionRequest?
    private var recognitionTask: SFSpeechRecognitionTask?

    private var lastVoiceActivityTime: CFTimeInterval = 0
    private var lastWordMatchTime: CFTimeInterval = 0
    private var sessionStartTime: CFTimeInterval = 0
    private var isRestartingSession: Bool = false

    init() {}

    deinit {
        stopVoiceFollow()
        stopDisplayLink()
    }

    func attach(_ surface: PrompterScrollSurface) {
        self.surface = surface
        surface.setManualScrollingEnabled(!isPlaying || isVoiceFollowActive)
        surface.displayScrollPosition(position)
        updateRemainingTime()
    }

    func detach(_ surface: PrompterScrollSurface) {
        if self.surface === surface {
            self.surface = nil
        }
        stopVoiceFollow()
        stopDisplayLink()
    }

    func play() {
        guard !isPlaying else { return }
        if reachedEnd || (maxPosition > 1 && position >= maxPosition - 1) {
            position = 0
            pendingSeekOffset = 0
            currentAnchorIndex = 0
            voiceTargetY = 0
            reachedEnd = false
            publishProgress(force: true)
            surface?.displayScrollPosition(position)
        }
        isPlaying = true
        surface?.setManualScrollingEnabled(isVoiceFollowActive)
        ensureDisplayLinkRunning()
    }

    func pause() {
        guard isPlaying else { return }
        isPlaying = false
        surface?.setManualScrollingEnabled(true)
        publishProgress(force: true)
        if !isVoiceFollowActive && abs(pendingSeekOffset) < 0.5 {
            stopDisplayLink()
        }
    }

    func toggle() {
        if isPlaying {
            pause()
        } else {
            play()
        }
    }

    func restart() {
        pause()
        pendingSeekOffset = 0
        position = 0
        currentAnchorIndex = 0
        voiceTargetY = 0
        reachedEnd = false
        surface?.displayScrollPosition(0)
        publishProgress(force: true)
    }

    func seek(by delta: CGFloat) {
        let adjustedDelta: CGFloat = abs(delta) > 100 ? (delta * 0.42) : delta
        let target = clampPosition(position + pendingSeekOffset + adjustedDelta)
        pendingSeekOffset = target - position
        voiceTargetY = target
        syncAnchorIndex(toScrollY: target)
        reachedEnd = (maxPosition > 0 && target >= maxPosition - 0.5)
        ensureDisplayLinkRunning()
    }

    func seekPage(forward: Bool) {
        let step = min(max(80, viewportHeight * 0.20), 145)
        let signedStep = forward ? step : -step
        let target = clampPosition(position + pendingSeekOffset + signedStep)
        pendingSeekOffset = target - position
        voiceTargetY = target
        syncAnchorIndex(toScrollY: target)
        reachedEnd = (maxPosition > 0 && target >= maxPosition - 0.5)
        ensureDisplayLinkRunning()
    }

    func seek(to newPosition: Double) {
        seek(to: CGFloat(newPosition))
    }

    func seek(to newPosition: CGFloat) {
        pendingSeekOffset = 0
        position = clampPosition(newPosition)
        voiceTargetY = position
        syncAnchorIndex(toScrollY: position)
        reachedEnd = (maxPosition > 0 && position >= maxPosition - 0.5)
        surface?.displayScrollPosition(position)
        publishProgress(force: true)
    }

    func seek(toProgress newProgress: Double) {
        let clamped = min(max(newProgress, 0), 1)
        seek(to: CGFloat(clamped) * maxPosition)
    }

    func updateFromManualScroll(_ newPosition: CGFloat) {
        guard !isPlaying || isVoiceFollowActive else { return }
        pendingSeekOffset = 0
        position = clampPosition(newPosition)
        voiceTargetY = position
        syncAnchorIndex(toScrollY: position)
        reachedEnd = (maxPosition > 0 && position >= maxPosition - 0.5)
        publishProgress(force: false)
    }

    func updateMetrics(maxPosition: CGFloat, viewportHeight: CGFloat) {
        self.maxPosition = max(1, maxPosition)
        self.viewportHeight = max(100, viewportHeight)
        self.position = clampPosition(self.position)
        self.voiceTargetY = clampPosition(self.voiceTargetY)
        surface?.displayScrollPosition(self.position)
        publishProgress(force: true)
    }

    // MARK: - Управление Голосовым Режимом (Voice-Follow)

    func updateVoiceAnchors(_ anchors: [VoiceWordAnchor]) {
        self.voiceAnchors = anchors
        syncAnchorIndex(toScrollY: position)
    }

    func toggleVoiceFollow() {
        if isVoiceFollowActive {
            stopVoiceFollow()
        } else {
            startVoiceFollow()
        }
    }

    func startVoiceFollow() {
        guard !isVoiceFollowActive else { return }
        voiceStatusText = "Проверка микрофона..."

        SFSpeechRecognizer.requestAuthorization { [weak self] authStatus in
            DispatchQueue.main.async {
                guard let self else { return }
                guard authStatus == .authorized else {
                    self.voiceStatusText = "Нет доступа к речи"
                    self.isVoiceFollowActive = false
                    return
                }
                self.requestMicAndBeginSession()
            }
        }
    }

    private func requestMicAndBeginSession() {
        let handlePermission: (Bool) -> Void = { [weak self] granted in
            DispatchQueue.main.async {
                guard let self else { return }
                guard granted else {
                    self.voiceStatusText = "Микрофон запрещён"
                    self.isVoiceFollowActive = false
                    return
                }
                self.launchAudioAndSpeechSession()
            }
        }

        if #available(iOS 17.0, *) {
            AVAudioApplication.requestRecordPermission(completionHandler: handlePermission)
        } else {
            AVAudioSession.sharedInstance().requestRecordPermission(handlePermission)
        }
    }

    private func launchAudioAndSpeechSession() {
        stopAudioPipelinesOnly()

        if reachedEnd || (maxPosition > 1 && position >= maxPosition - 1) {
            position = 0
            currentAnchorIndex = 0
            voiceTargetY = 0
            reachedEnd = false
            surface?.displayScrollPosition(0)
            publishProgress(force: true)
        } else {
            voiceTargetY = position
            syncAnchorIndex(toScrollY: position)
        }

        do {
            let session = AVAudioSession.sharedInstance()
            try session.setCategory(
                .playAndRecord,
                mode: .measurement,
                options: [.defaultToSpeaker, .allowBluetooth, .allowBluetoothA2DP, .mixWithOthers]
            )
            try session.setActive(true, options: .notifyOthersOnDeactivation)

            if speechRecognizer == nil {
                speechRecognizer = SFSpeechRecognizer(locale: Locale(identifier: "ru-RU"))
            }

            let inputNode = audioEngine.inputNode
            let recordingFormat = inputNode.outputFormat(forBus: 0)
            inputNode.removeTap(onBus: 0)
            inputNode.installTap(onBus: 0, bufferSize: 1024, format: recordingFormat) { [weak self] buffer, _ in
                guard let self else { return }
                self.recognitionRequest?.append(buffer)
                self.processMicrophoneLevel(buffer: buffer)
            }

            audioEngine.prepare()
            try audioEngine.start()

            startRecognitionTask()

            isVoiceFollowActive = true
            surface?.setManualScrollingEnabled(true)
            voiceStatusText = "Слушаю речь..."
            ensureDisplayLinkRunning()
        } catch {
            voiceStatusText = "Ошибка микрофона"
            isVoiceFollowActive = false
        }
    }

    private func startRecognitionTask() {
        recognitionTask?.cancel()
        recognitionTask = nil

        let request = SFSpeechAudioBufferRecognitionRequest()
        request.shouldReportPartialResults = true
        request.taskHint = .dictation
        if #available(iOS 13.0, *), speechRecognizer?.supportsOnDeviceRecognition == true {
            request.requiresOnDeviceRecognition = false
        }
        self.recognitionRequest = request
        self.sessionStartTime = CACurrentMediaTime()

        recognitionTask = speechRecognizer?.recognitionTask(with: request) { [weak self] result, error in
            guard let self else { return }
            if let result {
                let transcript = result.bestTranscription.formattedString
                DispatchQueue.main.async {
                    self.handleRecognizedTranscript(transcript)
                }
            }
            if error != nil || (result?.isFinal == true) {
                DispatchQueue.main.async {
                    self.restartRecognitionTaskIfNeeded()
                }
            }
        }
    }

    private func restartRecognitionTaskIfNeeded() {
        guard isVoiceFollowActive, !isRestartingSession, audioEngine.isRunning else { return }
        isRestartingSession = true
        recognitionRequest?.endAudio()
        recognitionTask?.cancel()
        DispatchQueue.main.asyncAfter(deadline: .now() + 0.08) { [weak self] in
            guard let self else { return }
            self.isRestartingSession = false
            if self.isVoiceFollowActive && self.audioEngine.isRunning {
                self.startRecognitionTask()
            }
        }
    }

    func stopVoiceFollow() {
        let wasActive = isVoiceFollowActive
        isVoiceFollowActive = false
        voiceAudioLevel = 0
        voiceStatusText = "Голос: Выкл"
        stopAudioPipelinesOnly()
        if wasActive && !isPlaying && abs(pendingSeekOffset) < 0.5 {
            stopDisplayLink()
        }
    }

    private func stopAudioPipelinesOnly() {
        if audioEngine.isRunning {
            audioEngine.stop()
        }
        audioEngine.inputNode.removeTap(onBus: 0)
        recognitionRequest?.endAudio()
        recognitionRequest = nil
        recognitionTask?.cancel()
        recognitionTask = nil
    }

    private func processMicrophoneLevel(buffer: AVAudioPCMBuffer) {
        guard let channelData = buffer.floatChannelData?[0] else { return }
        let frameLength = Int(buffer.frameLength)
        guard frameLength > 0 else { return }

        var sum: Float = 0
        let step = max(1, frameLength / 128)
        var count = 0
        var idx = 0
        while idx < frameLength {
            let sample = channelData[idx]
            sum += sample * sample
            count += 1
            idx += step
        }
        let rms = sqrt(sum / Float(max(1, count)))
        let normalizedLevel = min(max((rms - 0.008) * 18.0, 0), 1)

        DispatchQueue.main.async { [weak self] in
            guard let self, self.isVoiceFollowActive else { return }
            self.voiceAudioLevel = self.voiceAudioLevel * 0.65 + normalizedLevel * 0.35
            if normalizedLevel > 0.08 {
                self.lastVoiceActivityTime = CACurrentMediaTime()
            }
            // Автоперезапуск задачи каждые 52 сек во время микропаузы, чтобы обходить лимит 60 сек в iOS
            let now = CACurrentMediaTime()
            if now - self.sessionStartTime > 52.0 && (now - self.lastVoiceActivityTime > 0.4) {
                self.restartRecognitionTaskIfNeeded()
            }
        }
    }

    // MARK: - Алгоритм сопоставления русской речи с текстом сценария

    private func handleRecognizedTranscript(_ transcript: String) {
        guard isVoiceFollowActive, !voiceAnchors.isEmpty else { return }

        let spokenTokens = Self.tokenizeRussian(transcript, maxTailWords: 6)
        guard let lastSpoken = spokenTokens.last else { return }

        let now = CACurrentMediaTime()
        lastVoiceActivityTime = now

        let prevSpoken1 = spokenTokens.count >= 2 ? spokenTokens[spokenTokens.count - 2] : nil
        let prevSpoken2 = spokenTokens.count >= 3 ? spokenTokens[spokenTokens.count - 3] : nil

        // Окно поиска вокруг текущей позиции: от -2 слов назад до +26 слов вперёд
        let minIdx = max(0, currentAnchorIndex - 2)
        let maxIdx = min(voiceAnchors.count - 1, currentAnchorIndex + 26)
        guard minIdx <= maxIdx else { return }

        var bestIndex: Int?
        var bestScore: Double = 0

        for idx in minIdx...maxIdx {
            let anchor = voiceAnchors[idx]
            let primarySim = Self.wordSimilarity(spoken: lastSpoken, anchor: anchor)
            guard primarySim >= 0.72 else { continue }

            let jump = idx - currentAnchorIndex

            // Короткие союзы/предлоги (1-2 буквы) разрешаем только на соседней позиции или в паре с предыдущим словом
            var prevMatchSim: Double = 0
            if let prevSpoken1, idx >= 1 {
                prevMatchSim = max(
                    Self.wordSimilarity(spoken: prevSpoken1, anchor: voiceAnchors[idx - 1]),
                    idx >= 2 ? Self.wordSimilarity(spoken: prevSpoken1, anchor: voiceAnchors[idx - 2]) * 0.9 : 0
                )
            }

            if lastSpoken.norm.count <= 2 && jump > 2 && prevMatchSim < 0.75 {
                continue
            }

            // Для прыжка дальше чем на 9 слов вперёд требуем совпадение минимум двух слов подряд или длинного уникального слова
            if jump > 9 && prevMatchSim < 0.72 && lastSpoken.norm.count < 7 {
                continue
            }

            var prev2MatchSim: Double = 0
            if let prevSpoken2, idx >= 2 {
                prev2MatchSim = Self.wordSimilarity(spoken: prevSpoken2, anchor: voiceAnchors[idx - 2])
            }

            // Итоговый вес совпадения с приоритетом плавного движения вперёд
            let distancePenalty = abs(Double(jump - 1)) * 0.018
            let score = primarySim
                + (prevMatchSim >= 0.72 ? prevMatchSim * 0.85 : 0)
                + (prev2MatchSim >= 0.72 ? prev2MatchSim * 0.45 : 0)
                - distancePenalty

            if score > bestScore {
                bestScore = score
                bestIndex = idx
            }
        }

        if let matchedIdx = bestIndex {
            currentAnchorIndex = matchedIdx
            lastWordMatchTime = now

            // Целимся чуть вперёд текущей читаемой строки (+22 pt), чтобы взгляд всегда видел следующую фразу
            let matchedAnchor = voiceAnchors[matchedIdx]
            let leadOffset = min(max(18, viewportHeight * 0.04), 36)
            voiceTargetY = clampPosition(matchedAnchor.targetScrollY + leadOffset)

            let previewWords = spokenTokens.suffix(2).map(\.norm).joined(separator: " ")
            voiceStatusText = "«\(previewWords)»"
        }
    }

    private func syncAnchorIndex(toScrollY scrollY: CGFloat) {
        guard !voiceAnchors.isEmpty else {
            currentAnchorIndex = 0
            return
        }
        var closestIdx = 0
        var smallestDiff = CGFloat.greatestFiniteMagnitude
        for anchor in voiceAnchors {
            let diff = abs(anchor.targetScrollY - scrollY)
            if diff < smallestDiff {
                smallestDiff = diff
                closestIdx = anchor.index
            }
        }
        currentAnchorIndex = closestIdx
    }

    static func normalizeRussianWord(_ raw: String) -> String {
        let lowered = raw.lowercased().replacingOccurrences(of: "ё", with: "е")
        let scalars = lowered.unicodeScalars.filter { CharacterSet.alphanumerics.contains($0) }
        return String(String.UnicodeScalarView(scalars))
    }

    static func russianStem(for normalized: String) -> String {
        let count = normalized.count
        if count >= 7 {
            return String(normalized.prefix(count - 2))
        } else if count >= 5 {
            return String(normalized.prefix(count - 1))
        }
        return normalized
    }

    private static func tokenizeRussian(_ text: String, maxTailWords: Int) -> [(norm: String, stem: String)] {
        let parts = text.components(separatedBy: .whitespacesAndNewlines)
        var result: [(norm: String, stem: String)] = []
        for part in parts.suffix(maxTailWords * 2) {
            let norm = normalizeRussianWord(part)
            if !norm.isEmpty {
                result.append((norm: norm, stem: russianStem(for: norm)))
            }
        }
        if result.count > maxTailWords {
            return Array(result.suffix(maxTailWords))
        }
        return result
    }

    private static func wordSimilarity(spoken: (norm: String, stem: String), anchor: VoiceWordAnchor) -> Double {
        if spoken.norm == anchor.normalizedWord {
            return 1.0
        }
        if spoken.norm.count >= 4 && anchor.normalizedWord.count >= 4 {
            if spoken.stem == anchor.stem {
                return 0.90
            }
            if anchor.normalizedWord.hasPrefix(spoken.stem) || spoken.norm.hasPrefix(anchor.stem) {
                return 0.84
            }
        }
        if spoken.norm.count >= 5 && anchor.normalizedWord.count >= 5 {
            let dist = levenshteinDistance(spoken.norm, anchor.normalizedWord)
            if dist == 1 {
                return 0.82
            } else if dist == 2 && spoken.norm.count >= 8 {
                return 0.75
            }
        }
        return 0.0
    }

    private static func levenshteinDistance(_ a: String, _ b: String) -> Int {
        let aChars = Array(a)
        let bChars = Array(b)
        let m = aChars.count
        let n = bChars.count
        if abs(m - n) > 2 { return 3 }
        if m == 0 { return n }
        if n == 0 { return m }

        var prev = Array(0...n)
        var curr = [Int](repeating: 0, count: n + 1)

        for i in 1...m {
            curr[0] = i
            for j in 1...n {
                let cost = (aChars[i - 1] == bChars[j - 1]) ? 0 : 1
                curr[j] = min(prev[j] + 1, curr[j - 1] + 1, prev[j - 1] + cost)
            }
            prev = curr
        }
        return prev[n]
    }

    // MARK: - Кадровая развёртка 60/120 Гц

    private func clampPosition(_ value: CGFloat) -> CGFloat {
        min(max(0, value), maxPosition)
    }

    private func updateRemainingTime() {
        let remainingDistance = max(0, maxPosition - position)
        let effectiveSpeed = max(5.0, CGFloat(speed))
        let seconds = Int(ceil(remainingDistance / effectiveSpeed))
        if seconds != remainingSeconds {
            remainingSeconds = seconds
        }
    }

    private func publishProgress(force: Bool) {
        let newProgress = maxPosition > 0 ? min(max(Double(position / maxPosition), 0), 1) : 0
        if force || abs(newProgress - lastPublishedProgress) >= 0.002 {
            lastPublishedProgress = newProgress
            progress = newProgress
        }
        updateRemainingTime()
    }

    private func ensureDisplayLinkRunning() {
        guard displayLink == nil else { return }
        lastTimestamp = nil
        let link = CADisplayLink(target: self, selector: #selector(handleFrame(_:)))
        if #available(iOS 15.0, *) {
            link.preferredFrameRateRange = CAFrameRateRange(minimum: 60, maximum: 120, preferred: 120)
        }
        link.add(to: .main, forMode: .common)
        displayLink = link
    }

    private func stopDisplayLink() {
        displayLink?.invalidate()
        displayLink = nil
        lastTimestamp = nil
    }

    @objc private func handleFrame(_ link: CADisplayLink) {
        let now = link.timestamp
        let dt: CGFloat
        if let last = lastTimestamp {
            dt = CGFloat(min(max(now - last, 1.0 / 240.0), 0.1))
        } else {
            dt = 1.0 / 60.0
        }
        lastTimestamp = now

        var changed = false
        let mediaNow = CACurrentMediaTime()

        if isVoiceFollowActive {
            // Режим голосового слежения: двигаем текст к распознанной строке и мягко скользим во время речи
            let isSpeakingRecently = (mediaNow - lastVoiceActivityTime) < 0.38
            let matchedRecently = (mediaNow - lastWordMatchTime) < 0.90
            let diff = voiceTargetY - position

            if abs(diff) > 0.8 && (isSpeakingRecently || matchedRecently) {
                let basePace = max(28.0, CGFloat(speed))
                let catchUpVelocity = min(max(diff * 3.4, -basePace * 1.8), basePace * 2.8)
                position += catchUpVelocity * dt
                changed = true
            } else if isSpeakingRecently && diff >= -8 {
                // Плавное микро-скольжение между словами, пока звучит голос (не дальше +65 pt от последнего слова)
                let maxLead = min(maxPosition, voiceTargetY + 65)
                if position < maxLead {
                    position += CGFloat(speed) * 0.42 * dt
                    changed = true
                }
            }
        } else if isPlaying {
            // Классический режим постоянной скорости
            position += CGFloat(speed) * dt
            changed = true
        }

        // Плавная доводка при нажатии кнопок пульта «вперёд/назад»
        if abs(pendingSeekOffset) > 0.3 {
            let smoothing = min(1.0, dt * 14.0)
            let step = pendingSeekOffset * smoothing
            position += step
            pendingSeekOffset -= step
            changed = true
        } else if pendingSeekOffset != 0 {
            position += pendingSeekOffset
            pendingSeekOffset = 0
            changed = true
        }

        if changed {
            position = clampPosition(position)
            surface?.displayScrollPosition(position)
            publishProgress(force: false)

            if maxPosition > 1 && position >= maxPosition - 0.5 {
                position = maxPosition
                pendingSeekOffset = 0
                reachedEnd = true
                if isPlaying {
                    isPlaying = false
                }
                surface?.setManualScrollingEnabled(true)
                publishProgress(force: true)
                if !isVoiceFollowActive {
                    stopDisplayLink()
                    return
                }
            }
        }

        if !isPlaying && !isVoiceFollowActive && abs(pendingSeekOffset) <= 0.3 {
            pendingSeekOffset = 0
            publishProgress(force: true)
            stopDisplayLink()
        }
    }
}
